{
  "name": "all-might-ui",
  "private": false,
  "version": "0.1.0",
  "description": "Libreria de componentes UI reutilizables en React + TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JYBLOCKS/all-might-ui.git"
  },
  "homepage": "https://github.com/JYBLOCKS/all-might-ui#readme",
  "bugs": {
    "url": "https://github.com/JYBLOCKS/all-might-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run build:app",
    "build:app": "tsc -b && vite build",
    "build:lib": "pnpm run clean && vite build --mode library && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "lucide-react": "^1.17.0"
  }
}
